# Etapa 1: API e dry-run não precisam de variáveis, credenciais ou arquivo .env.
# Os nomes abaixo documentam a configuração prevista no PRD para etapas futuras.
# Não há carregamento automático de .env nesta etapa. Não coloque segredos aqui.

# Etapa 2: confirmar o contrato antes de configurar/utilizar o gateway.
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODELS=azure/gpt-5-mini,azure/gpt-6-luna
DEFAULT_CHAT_MODEL=azure/gpt-5-mini
EMBEDDING_MODEL=cohere/embed-v4.0
# Preencher somente após medir a dimensão retornada pelo gateway.
EMBEDDING_DIMENSION=

# Etapa 3: sem acesso ao Qdrant na Etapa 1.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=

# Etapas posteriores: token obrigatório na publicação.
API_ACCESS_TOKEN=
MAX_OUTPUT_TOKENS=600
REQUEST_TIMEOUT_SECONDS=90
MAX_CONCURRENT_REQUESTS=2
# PORT será fornecida pela hospedagem; localmente passe --port ao Uvicorn.
