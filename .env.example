# /health, /docs, /models e dry-run não precisam de credenciais.
# O comando check_gateway --execute lê variáveis exportadas no processo.
# Não há carregamento automático de .env. Não coloque segredos aqui.

# Gateway: usadas por comandos reais explícitos e pelo cliente compartilhado da API.
# Abrir o cliente no startup não executa chamadas de modelos.
# URL base completa fornecida pelo gateway, incluindo /v1 se aplicável,
# sem o sufixo /chat/completions ou /embeddings.
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODELS=azure/gpt-5-mini,azure/gpt-6-luna
DEFAULT_CHAT_MODEL=azure/gpt-5-mini
EMBEDDING_MODEL=cohere/embed-v4.0
# Preencher somente após medir a dimensão retornada pelo gateway.
EMBEDDING_DIMENSION=

# Etapa 3: preencher coleção e dimensão medida para indexar, recuperar e /ready.
# Local: deixar URL/chave vazias. Remoto: URL HTTPS e chave privada obrigatórias.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
# Escolher nome versionado, por exemplo saude_mental_v1. Não reutilizar
# coleção de outra dimensão, modelo, pipeline ou conteúdo dos PDFs.
QDRANT_COLLECTION=

# Se preenchido, exige Bearer em /chat e /chat/stream; Authorize no Swagger.
# Vazio permite desenvolvimento local; RENDER=true exige valor no startup.
# No Render, preencher pelo painel Environment. Nunca versionar o valor real.
API_ACCESS_TOKEN=
# Etapa 2: max_completion_tokens candidato; verificação limitada a até 600.
MAX_OUTPUT_TOKENS=600
# Prazo total de consulta JSON/SSE, incluindo recuperação e geração.
# Nos comandos de ingestão/verificação, limita cada chamada de modelo.
REQUEST_TIMEOUT_SECONDS=90
# Capacidade compartilhada JSON/SSE por processo; rejeita com 429, sem fila.
# Usar um worker; não é uma cota global entre processos nem de gasto acumulado.
MAX_CONCURRENT_REQUESTS=2
# PORT será fornecida pela hospedagem; localmente passe --port ao Uvicorn.
